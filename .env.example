# 复制为 .env 后按需修改。.env 不要提交。
#
# 不带任何 key 也能启动：改写走本地模板、配音走估算时间轴、
# 质检第 14 项强制 warn，provenance.degraded 会写明原因。

# ---------- 服务 ----------
PORT=8787
LOCAL_TOKEN=dev-token
ORG_ID=00000000-0000-0000-0000-000000000001

# ---------- Postgres ----------
POSTGRES_USER=koubo
POSTGRES_PASSWORD=koubo
POSTGRES_DB=koubo

# ---------- 对象存储（S3 兼容） ----------
# Docker 内由 api 访问 http://s3:9000，不向宿主机暴露 9000
S3_ACCESS_KEY=koubo
S3_SECRET_KEY=koubo12345678
S3_BUCKET=koubo
S3_REGION=us-east-1

# ---------- 模型（全可选） ----------
# 文本：DeepSeek 直连
DEEPSEEK_API_KEY=
# 语音：火山 TTS
TTS_API_KEY=
VOLC_TTS_TOKEN=
# 图片 / 视频：即梦（方舟）
ARK_API_KEY=
# 可灵
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# 海螺 h3
HAILUO_API_KEY=
# 中转（kie 等）
RELAY_API_KEY=
