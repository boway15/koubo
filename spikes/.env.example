# 三个模型的最小验证环境（只填需要的）

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com

# ---------- 即梦 / 火山方舟（也用于多模态视觉质检） ----------
ARK_API_KEY=
ARK_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=

# ---------- 可灵 Kling ----------
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE=https://api-beijing.klingai.com

# ---------- 海螺 / MiniMax ----------
HAILUO_API_KEY=
HAILUO_GROUP_ID=
HAILUO_MODEL=MiniMax-Hailuo-02
HAILUO_BASE=https://api.minimax.chat

# ---------- 中转（kie.ai 类） ----------
RELAY_API_KEY=
RELAY_BASE=https://api.kie.ai
RELAY_MODEL=veo3

# ---------- 视觉质检（多模态） ----------
# 不填则回退到 ARK_API_KEY，模型默认 doubao-vision
VISION_API_KEY=
VISION_MODEL=doubao-vision
VISION_BASE=https://ark.cn-beijing.volces.com/api/v3
